BOT_TOKEN=change-me
DATABASE_URL=postgresql+asyncpg://price:price@localhost:5433/price
LOG_LEVEL=INFO
# Timezone for stored/returned timestamps (Postgres container defaults to UTC).
TIMEZONE=Asia/Samarkand

# Bootstrap SUPER_ADMIN(s): comma-separated Telegram numeric ids.
# These users become SUPER_ADMIN on first contact and can then invite admins
# and users from inside the bot. Everyone else is auto-registered as USER.
# All runtime role checks read the users table; this only seeds the first owner.
# Find your id by writing to @userinfobot in Telegram. Several: 111,222,333
ADMIN_IDS=
