BOT_TOKEN=change-me
DATABASE_URL=postgresql+asyncpg://price:price@localhost:5433/price
LOG_LEVEL=INFO
# Timezone for stored/returned timestamps (Postgres container defaults to UTC).
TIMEZONE=Asia/Samarkand

# Security / access control (comma-separated Telegram numeric ids).
# Find your id by writing to @userinfobot in Telegram.
# ADMIN_IDS     - admins: may import Excel and add/update/delete products.
# ALLOWED_USERS - regular users: may only search and view. Admins are allowed
#                 automatically and do not need to be listed here.
# A user NOT in either list cannot use the bot at all ("Доступ запрещён").
ADMIN_IDS=
ALLOWED_USERS=
